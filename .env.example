# ── Server ─────────────────────────────────────────────
PORT=7001                 # port HTTP API shard ini
WS_PORT=                  # port WebSocket (default dari config)
NODE_ENV=production

# ── Backend / webhook (WAJIB) ──────────────────────────
WEBHOOK_URL=              # endpoint webhook backend, mis. https://backend-anda.example/webhookv2.php
DEFAULT_BE_BASE=          # basis URL backend, mis. https://backend-anda.example
EVENT_WEBHOOK_URL=        # opsional; default {DEFAULT_BE_BASE}/webhook_events.php
WEBHOOK_API_KEY=          # WAJIB — kunci rahasia antara engine <-> backend
WEBHOOK_SECRET=           # opsional; default = WEBHOOK_API_KEY
BROADCAST_KEY=            # header x-broadcast-key; default = WEBHOOK_API_KEY
ADMIN_PROXY_REASSIGN_KEY= # kunci endpoint admin reassign proxy
SESSION_WARMUP_API_KEY=   # opsional; default = WEBHOOK_API_KEY

# ── Akses ──────────────────────────────────────────────
ALLOWED_IPS=              # IP backend yang boleh memanggil API, dipisah koma
ALLOWED_IPS_EXTRA=
WS_ALLOWED_IPS_EXTRA=

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Proxy (opsional) ───────────────────────────────────
GET_PROXY_URL=
GET_PROXY_URL_SECONDARY=
GET_PROXY_API_KEY=

# ── WhatsApp ───────────────────────────────────────────
BAILEYS_USE=byee-wamod    # library yang dipakai wrapper
WA_WEB_VERSION=
WA_BROWSER=Mac OS,Chrome,14.4.1

# ── Penyimpanan sesi ───────────────────────────────────
CLEANUP_SESSIONS_DIR=./sessions
